# ============================================================================
#  NLCC configuration — copy this file to ".env" and fill in your own values.
#  (.env itself is git-ignored so your keys never get committed to GitHub.)
# ============================================================================

# ---- Firebase (RECOMMENDED — proper cloud DATABASE + secure AUTH + image hosting)
#
# 1. Create a free project at https://console.firebase.google.com
# 2. Project settings > "Your apps" > add a Web App (</>) > copy firebaseConfig.
# 3. Authentication > enable Email/Password > add your admin user.
# 4. Firestore Database > Create database > add the rules in SETUP.md.
# 5. Storage > Get started > add the rules in SETUP.md.
# Leave all Firebase vars blank to run in LOCAL mode (localStorage + demo data).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Local admin login (used only when Firebase is NOT configured above)
VITE_ADMIN_EMAIL=bhola.paneru@nlccuk.com
VITE_ADMIN_PASSWORD=nlcc-admin-2026

# ---- Contact form email delivery (sends submissions to bhola.paneru@nlccuk.com)
# 1. Go to https://web3forms.com and enter bhola.paneru@nlccuk.com
# 2. Copy the access key you receive by email
# 3. Paste it below
VITE_WEB3FORMS_KEY=
